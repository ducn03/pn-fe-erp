{
	"name": "pn-fe-erp",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#core": "./src/lib/core/index.ts",
		"#core/*": "./src/lib/core/*",
		"#ui": "./src/lib/premier-ui/index.ts",
		"#ui/*": "./src/lib/premier-ui/*",
		"#features": "./src/lib/features/index.ts",
		"#features/*": "./src/lib/features/*",
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
